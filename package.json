{
  "name": "inspection-image-platform",
  "version": "0.1.0",
  "description": "검사 사진의 AI 판독과 보수 후속 업무를 관리하는 검사 플랫폼입니다.",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:web\" \"npm:dev:api\"",
    "dev:private": "concurrently --kill-others \"npm:dev:web:private\" \"npm:dev:api:private\"",
    "dev:web:private": "WATCHPACK_POLLING=true NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_BASE_URL=http://127.0.0.1:4100 next dev --webpack --hostname 127.0.0.1 --port 3100",
    "dev:api:private": "DOTENV_CONFIG_PATH=local/private-runtime/api.env DISABLE_BACKGROUND_WORKERS=1 node server/index.mjs",
    "dev:web": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/start-web.mjs",
    "start:api": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "infra:up": "docker compose up -d mysql minio",
    "infra:stop": "docker compose stop",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:model:up": "docker compose -f compose.yaml -f compose.model.yaml --profile app up -d --build",
    "stack:model:stop": "docker compose -f compose.yaml -f compose.model.yaml --profile app stop",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src server scripts tests next.config.ts tsconfig.json compose.yaml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junhang-dev/inspection-image-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/junhang-dev/inspection-image-platform/issues"
  },
  "homepage": "https://github.com/junhang-dev/inspection-image-platform#readme",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "cors": "2.8.6",
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "minio": "8.0.7",
    "multer": "2.4.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "three": "0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "private": true
}
