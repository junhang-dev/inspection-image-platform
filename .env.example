# Copy with `npm run setup`: random local credentials are generated in ignored .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=inspection
MYSQL_USER=inspection
MYSQL_PASSWORD=replace-with-local-secret
MYSQL_ROOT_PASSWORD=replace-with-local-secret
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=inspection-local
MINIO_SECRET_KEY=replace-with-local-secret
MINIO_BUCKET=inspection-images
API_HOST=127.0.0.1
API_PORT=4000
# Dedicated disk directory; keep it across API restarts. Compose uses a named volume.
UPLOAD_TEMP_DIR=./uploads/incoming
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mac Next server may proxy /api locally. Hosted frontends must use a separate Mac API URL.
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_BASE_URL=http://127.0.0.1:4000
MODEL_API_URL=http://127.0.0.1:8001
MODEL_DOCKER_API_URL=http://host.docker.internal:8001
# Public demonstrations accept only the five approved demo byte hashes.
PUBLIC_DEMO_ONLY=0
NEXT_PUBLIC_DEMO_ONLY=0
# Public-upload disclosure flags; these do not enforce access control.
# Set both to 1 only for user-approved publicly shareable uploads.
# PUBLIC_DEMO_ONLY=1 is the server switch that rejects non-demo bytes.
PUBLIC_UPLOADS_ALLOWED=0
NEXT_PUBLIC_PUBLIC_UPLOADS_ALLOWED=0
# Optional five-service Compose; keep the real absolute paths in ignored .env.
MODEL_WEIGHTS_PATH=
MODEL_CONTRACT_PATH=
